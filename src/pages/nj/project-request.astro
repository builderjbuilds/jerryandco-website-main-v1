---
// NJ Design-Build — Lead intake. Ported from
// New NJ Design-Build Funnel Spec/02_lead-intake_site-visit-request.html
// per the build spec Section 4.2. Two-page handoff to /nj/book-site-visit/
// (the spec's stated default when the inline-vs-two-page decision is
// unresolved) — NJLeadForm.astro owns the submit/confirm/handoff logic.
import Base from '../../layouts/Base.astro';
import NJHeader from '../../components/nj/NJHeader.astro';
import NJFooter from '../../components/nj/NJFooter.astro';
import NJLeadForm from '../../components/nj/NJLeadForm.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';

const title = 'NJ Design-Build Project Request | Jerry & Co.';
const description =
  "Turn the backyard you have into the space you actually use — one site visit, a fixed price in writing, and our NJ build partner's license verified before you sign anything.";
const canonical = 'https://www.jerryandcohome.com/nj/project-request/';

// Real headshots pulled from /img/testimonials/ (same set data/testimonials.json
// uses on the MA cabinet-refinishing homepage) — real named clients' actual
// photos, not AI-generated.
const testimonials = [
  { headshot: 'ceri-charlestown-ma_testimonial-headshot.jpg', quote: 'Jerry has completed multiple projects for us over the years, from repairs and finish work to larger renovations. His craftsmanship, reliability, and attention to detail are consistently outstanding. We trust him completely and wouldn’t hesitate to recommend Jerry & Co. to others.', who: 'Ceri L.' },
  { headshot: 'alyssa-charlestown-ma_testimonial-headshot.jpg', quote: 'Jerry transformed our outdated bathroom into a bright, timeless space we absolutely love. He was professional, communicative, and detail-oriented throughout the entire project. The craftsmanship exceeded our expectations.', who: 'Alyssa A.' },
  { headshot: 'julia-boston-ma_testimonial-headshot.jpg', quote: 'Working with Jerry was a fantastic experience from start to finish. He listened carefully to our vision, helped us make smart design decisions, and delivered exceptional quality throughout.', who: 'Julia T.' },
];

const steps = [
  { title: "Send What You've Already Got", body: "Plans and zoning approval if you have them, or just your idea and address if you don't. Two minutes, and you're on the calendar." },
  { title: 'We Walk the Actual Space With You', body: 'On-site — plans in hand if you have them, tape measure if you don\'t. Platform height, stair placement, roofline, where power runs. You see exactly how it gets built, not a rendering.' },
  { title: 'You Get a Firm Number and a Start Date', body: 'Not a range — a fixed price based on your real plans, backed by a build partner ready to pull the permit and start.' },
];

const breadcrumbSchema = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.jerryandcohome.com/' },
    { '@type': 'ListItem', position: 2, name: 'Backyard Design-Build — NJ', item: 'https://www.jerryandcohome.com/nj/backyard-design-build/' },
    { '@type': 'ListItem', position: 3, name: 'Project Request', item: canonical },
  ],
};
---

<Base title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', ...breadcrumbSchema })} />
  </Fragment>

  <NJHeader ctaHref="#nj-intake-form-card" ctaLabel="Start My Request" />

  <div class="hero-top wrap">
    <div class="eyebrow">NJ / NY-Metro · Backyard Additions &amp; Design-Build</div>
    <h1>Turn the Backyard You Have Into the Space You Actually Use — With One Firm Price.</h1>
    <p class="subhead">Plans and zoning already approved, or just an idea and a backyard? Either way, one site visit gets you a real path forward. Jerry walks the space with you, plans in hand if you've got them, and you leave knowing exactly what it costs and when work starts — not another callback promise.</p>
    <p class="trust-strip">Design + project management by Jerry &amp; Co. (MA HIC #208336) · Built by our vetted NJ partner crew.</p>
  </div>

  <section class="hero-band">
    <div class="wrap">
      <PlaceholderImage
        publicId="nj-design-build/intake-hero-proof"
        alt="A finished backyard addition in full daylight showing clean trim lines and finished siding detail"
        aspect="4/3"
        className="intake-hero-img"
        loading="eager"
        fetchpriority="high"
      />
      <NJLeadForm />
    </div>
  </section>

  <section class="steps">
    <div class="wrap">
      <h2>What Happens After You Submit</h2>
      <div class="steps-grid">
        {steps.map((step, i) => (
          <div class="step-card">
            <div class="num">{i + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="testimonials">
    <div class="wrap">
      <div class="eyebrow">Testimonials</div>
      <h2>What others are saying</h2>
      <div class="t-grid">
        {testimonials.map((t) => (
          <div class="t-card">
            <img class="avatar" src={`/img/testimonials/${t.headshot}`} alt={`${t.who}, Jerry & Co. client`} loading="lazy" />
            <div class="stars">★★★★★</div>
            <p>&ldquo;{t.quote}&rdquo;</p>
            <div class="who">— {t.who}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <NJFooter />
</Base>

<style>
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .hero-top { padding: 44px 24px 28px; text-align: center; }
  .eyebrow { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-deep); font-weight: 700; margin-bottom: 14px; }
  h1 { font-family: var(--font-serif); font-size: clamp(28px, 4.2vw, 46px); line-height: 1.12; color: var(--forest); max-width: 820px; margin: 0 auto 18px; }
  .subhead { font-size: 16px; line-height: 1.6; color: var(--text-muted); max-width: 640px; margin: 0 auto; }
  .trust-strip { font-size: 12.5px; color: var(--forest); font-weight: 600; max-width: 640px; margin: 16px auto 0; line-height: 1.6; }

  .hero-band {
    background: linear-gradient(160deg, var(--forest) 0%, var(--ink) 100%);
    padding: 40px 0 72px;
    position: relative;
    overflow: hidden;
  }
  .hero-band .wrap { max-width: 620px; }
  :global(.intake-hero-img) { border-radius: 14px; margin-bottom: 28px; box-shadow: 0 20px 50px rgba(0,0,0,0.28); }

  .steps { padding: 64px 0; }
  .steps h2 { text-align: center; font-family: var(--font-serif); font-size: 30px; color: var(--forest); margin-bottom: 36px; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .step-card { background: var(--forest); color: var(--bone); border-radius: 10px; padding: 26px 22px; }
  .step-card .num { width: 30px; height: 30px; border-radius: 50%; background: var(--gold); color: var(--ink); font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .step-card h3 { font-family: var(--font-serif); font-size: 17px; margin-bottom: 8px; line-height: 1.3; color: var(--bone); }
  .step-card p { font-size: 13px; line-height: 1.55; color: #D9E2DD; margin: 0; }

  .testimonials { background: var(--forest); color: var(--bone); padding: 60px 0; }
  .testimonials .eyebrow { color: var(--gold); text-align: center; }
  .testimonials h2 { text-align: center; color: #fff; font-family: var(--font-serif); font-size: 28px; margin-bottom: 36px; }
  .t-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .t-card { text-align: center; }
  .avatar {
    width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 10px; object-fit: cover;
    border: 2px solid var(--gold);
  }
  .stars { color: var(--gold); font-size: 13px; letter-spacing: 2px; margin-bottom: 10px; }
  .t-card p { font-size: 13px; font-style: italic; line-height: 1.6; color: #E7EDE9; }
  .t-card .who { margin-top: 8px; font-style: normal; color: var(--gold); font-size: 12px; font-weight: 600; }

  @media (max-width: 720px) {
    .steps-grid, .t-grid { grid-template-columns: 1fr; }
  }
</style>
