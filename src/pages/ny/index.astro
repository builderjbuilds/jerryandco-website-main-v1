---
// NY Division home — rebuilt as a lifestyle-first, persona-locked asset
// (Equity-Rich Homeowner analog) per the 2026 market research: outdoor-living
// contractor pages convert on "lifestyle-transformation messaging for
// high-value entertainment spaces," not a service menu. The original version
// of this page was a pure 3-path router with no emotional argument of its
// own — this version leads with the mental movie (entertaining, curb appeal,
// resale value) and demotes the router to a supporting "three ways we build
// it" section further down, once the reader is already sold on the premise.
//
// No "licensed" claim anywhere on this page — Westchester registration isn't
// confirmed active yet (Section 2.2 of the launch strategy) — so every trust
// claim here is "insured" / "permit-coordinated," which is true today.
import Base from '../../layouts/Base.astro';
import NYHeader from '../../components/ny/NYHeader.astro';
import NYTrustChips from '../../components/ny/NYTrustChips.astro';
import NYProcessSteps from '../../components/ny/NYProcessSteps.astro';
import CTABand from '../../components/CTABand.astro';
import NYFooter from '../../components/ny/NYFooter.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';

const title = 'Outdoor Living — Fencing, Patios & Additions | Jerry & Co. Westchester';
const description =
  'Jerry & Co.’s Westchester County outdoor-living division: fencing, patios, decks, and additions built for how you actually live outside — insured, permit-coordinated, same-day written quotes.';
const canonical = 'https://www.jerryandcohome.com/ny/';

const trends = [
  {
    title: 'Front-of-home living, not just the backyard',
    body: 'Curb-facing porches, entry patios, and front-yard seating are the fastest-growing category nationally in 2026 — a fence and patio job is increasingly a first-impression project, not just a backyard one.',
  },
  {
    title: 'Composite has overtaken wood',
    body: 'For the first time, composite decking outsells wood nationally — no annual staining, and it holds up better through a Northeast winter than most homeowners expect.',
  },
  {
    title: 'Multi-zone yards',
    body: 'Instead of one all-purpose patio, the trend is separate zones — a dining spot, a lounge area, a fire feature — laid out so the yard works for more than one thing at once.',
  },
  {
    title: 'Lower-maintenance landscaping',
    body: 'Drought-tolerant, native plantings around new hardscaping are replacing high-maintenance lawns — less mowing, less fertilizer, and a yard that still looks intentional in August.',
  },
];
---

<Base title={title} description={description} canonical={canonical}>
  <NYHeader />

  <section class="ny-home-hero">
    <div class="ny-home-hero-bg">
      <PlaceholderImage
        publicId="ny/aspirational/hero-backyard-evening"
        alt="Concept rendering of a finished backyard patio and pergola at golden hour — aspirational, not an actual completed project"
        aspect="16/9"
        className="ny-home-hero-bg-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="ny-home-hero-scrim" aria-hidden="true"></div>
    </div>
    <div class="wrap">
      <p class="eyebrow">Outdoor Living Division — Westchester County</p>
      <h1>Your Backyard Isn't Landscaping. It's the Room You Forgot You Had.</h1>
      <p class="lede">
        Picture the version of your yard that actually gets used — dinner moves outside
        without anyone asking, the fence means you stop closing the blinds at 6pm, the deck
        holds a full table on a Saturday instead of one folding chair nobody sits in.
        Fencing, patios, pergolas, decks, and additions — insured and permit-coordinated on
        every job, quoted the same day we walk the property.
      </p>
      <div class="ny-home-hero-chips"><NYTrustChips /></div>
      <div class="ny-home-hero-cta">
        <a class="btn btn-gold" href="tel:+13476026801">Call or text (347) 602-6801</a>
        <a class="ny-hero-secondary" href="#ny-paths">See pricing by project type &darr;</a>
      </div>
    </div>
  </section>

  <section class="ny-imagine">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <p class="eyebrow">See it before you book it</p>
        <h2>Imagine This Backyard, Six Weeks From Now.</h2>
      </div>
      <div class="ny-ba-grid" data-reveal="up">
        <div class="ny-ba-panel">
          <span class="ny-ba-label">Before</span>
          <PlaceholderImage
            publicId="ny/aspirational/before-backyard-patio"
            alt="Concept rendering of a neglected backyard fence and cracked patio — aspirational, not an actual completed project"
            aspect="4/3"
            className="ny-ba-img"
            caption="Concept rendering — aspirational, not an actual project"
            loading="lazy"
          />
        </div>
        <div class="ny-ba-panel">
          <span class="ny-ba-label is-after">After</span>
          <PlaceholderImage
            publicId="ny/aspirational/after-backyard-patio"
            alt="Concept rendering of a finished cedar fence, bluestone patio, and pergola — aspirational, not an actual completed project"
            aspect="4/3"
            className="ny-ba-img"
            caption="Concept rendering — aspirational, not an actual project"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="ny-lifestyle">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <p class="eyebrow">Entertaining, curb appeal &amp; everyday living</p>
        <h2>The best room in the house might not have a roof.</h2>
      </div>
      <div class="ny-lifestyle-grid" data-reveal="up">
        <div class="ny-lifestyle-copy">
          <p>
            A properly built fence and patio doesn't just look better from the street — it
            changes what a Tuesday night looks like. Kids play in a yard that's actually
            enclosed instead of everyone hovering by the door. Guests move outside at a
            cookout instead of crowding the kitchen. A pergola turns a patio that's unusable
            in July sun and October drizzle into a space you can actually sit in nine months
            a year.
          </p>
          <p>
            And when it's time to sell, a finished deck is one of the few exterior projects
            buyers and appraisers both notice on a walkthrough — Remodeling Magazine's Cost
            vs. Value Report puts typical deck-addition recoup at 65–80% of build cost, among
            the highest of any exterior improvement category. This isn't a cosmetic upgrade.
            It's the rare project that pays you back twice — once every evening you use it,
            once when you sell.
          </p>
        </div>
        <NYTrustChips variant="dark" />
      </div>
    </div>
  </section>

  <section class="ny-trust">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <p class="eyebrow">Why "insured and permit-coordinated" actually matters here</p>
        <h2>Most backyard contractors in this market skip the paperwork.</h2>
        <p>
          No insurance certificate, no permit filing, no inspection — that's how a fence
          dispute with a neighbor turns into a survey problem, or a patio job gets red-tagged
          mid-build. Every Jerry &amp; Co. project runs through the same process regardless of
          size: a real contract, a real timeline, and work that still looks right when a
          buyer's inspector walks the yard in five years. Ask any contractor in this price
          tier for proof of insurance and a permit plan — most can't produce either on the spot.
        </p>
      </div>
    </div>
  </section>

  <section class="ny-paths" id="ny-paths">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <p class="eyebrow">Three ways we build it</p>
        <h2>Pick the one that matches what's actually going on.</h2>
      </div>

      <div class="ny-path-grid" data-reveal="up">
        <a class="ny-path-card" href="/ny/fencing-sheds-patios/">
          <PlaceholderImage
            publicId="ny/aspirational/fencing-patio"
            alt="Concept rendering of a cedar fence and paver patio — aspirational, not an actual completed Jerry & Co. project"
            aspect="16/10"
            className="ny-path-img"
            caption="Concept rendering — real Westchester projects coming soon"
            loading="lazy"
          />
          <p class="ny-path-tag">Homeowners</p>
          <h3>Fencing, Sheds &amp; Patios</h3>
          <p>Fencing, sheds, pergolas, patios, interior refresh. A same-day written quote, tiered three ways.</p>
          <span class="ny-path-cta">See homeowner pricing &rarr;</span>
        </a>
        <a class="ny-path-card" href="/ny/landlord-property-management/">
          <PlaceholderImage
            publicId="ny/aspirational/landlord-multifamily"
            alt="Concept rendering of a Westchester multi-family rental exterior — aspirational, not an actual completed Jerry & Co. project"
            aspect="16/10"
            className="ny-path-img"
            caption="Concept rendering — real Westchester projects coming soon"
            loading="lazy"
          />
          <p class="ny-path-tag">Landlords &amp; PMs</p>
          <h3>Turnover &amp; Preferred-Vendor Work</h3>
          <p>One contractor, a written turnaround window, preferred-vendor pricing across your portfolio.</p>
          <span class="ny-path-cta">See landlord terms &rarr;</span>
        </a>
        <a class="ny-path-card is-featured" href="/ny/backyard-additions-design-build/">
          <PlaceholderImage
            publicId="ny/aspirational/deck-addition"
            alt="Concept rendering of a cedar deck addition with pergola — aspirational, not an actual completed Jerry & Co. project"
            aspect="16/10"
            className="ny-path-img"
            caption="Concept rendering — real Westchester projects coming soon"
            loading="lazy"
          />
          <p class="ny-path-tag">Bigger Projects</p>
          <h3>Decks, Additions &amp; Enclosures</h3>
          <p>A paid design phase gets you a firm, fixed-price, permitted build quote before anyone swings a hammer.</p>
          <span class="ny-path-cta">See design-build tiers &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ny-trends">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <p class="eyebrow">What's actually trending in Westchester backyards this year</p>
        <h2>2026 is the year outdoor living stopped being an afterthought.</h2>
      </div>
      <div class="ny-trend-grid" data-reveal="up">
        {trends.map((t) => (
          <div class="ny-trend-card">
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <NYProcessSteps />

  <section class="ny-track-record">
    <div class="wrap">
      <p class="ny-track-record-line">7 years. 100+ projects. The same standard, now in Westchester County.</p>
    </div>
  </section>

  <CTABand
    eyebrow="Same-day written quotes, three ways to work with us"
    headline="Tell us what's going on and we'll point you to the right quote"
    ctaText="Call or text (347) 602-6801"
    ctaHref="tel:+13476026801"
    reassurance="Or pick your path above — each page has its own quote form and calendar."
  />

  <NYFooter />
</Base>

<style>
  .ny-home-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 108px) 0 clamp(48px, 5vw, 72px);
    background: #fff;
    text-align: center;
  }
  .ny-home-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .ny-home-hero-bg :global(.ny-home-hero-bg-img.ph) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
  }
  .ny-home-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(255, 255, 255, 0.86);
  }
  .ny-home-hero .wrap { position: relative; z-index: 2; max-width: 820px; }
  .ny-home-hero h1 {
    font-size: clamp(2.35rem, 4.8vw, 3.4rem);
    letter-spacing: -0.03em;
    margin: 12px 0 20px;
  }
  .ny-home-hero .lede { font-size: 17.5px; }
  .ny-home-hero-chips { display: flex; justify-content: center; margin-top: 24px; }
  .ny-home-hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .ny-hero-secondary {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }
  .ny-hero-secondary:hover { color: var(--gold-deep); }

  .ny-imagine { background: #fff; padding: clamp(48px, 6vw, 80px) 0; }
  .ny-ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  .ny-ba-panel { position: relative; }
  .ny-ba-label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 4;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    background: rgba(20, 36, 31, 0.72);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .ny-ba-label.is-after { background: var(--gold-deep); }
  :global(.ny-ba-img) { border-radius: var(--radius-sm); }

  .ny-lifestyle { background: var(--ink); color: var(--bone); padding: clamp(56px, 7vw, 96px) 0; }
  .ny-lifestyle .eyebrow { color: var(--gold); }
  .ny-lifestyle h2 { color: var(--bone); }
  .ny-lifestyle-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 32px;
  }
  .ny-lifestyle-copy p {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(247, 243, 234, 0.85);
    margin: 0 0 20px;
  }
  .ny-lifestyle-copy p:last-child { margin-bottom: 0; }

  .ny-trust { background: var(--bone-deep); padding: clamp(48px, 6vw, 80px) 0; }

  .ny-paths { background: #fff; padding: clamp(48px, 6vw, 80px) 0; }
  .ny-path-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .ny-path-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--bone-deep);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: clamp(28px, 3vw, 36px);
    box-shadow: 0 2px 0 var(--line), 0 12px 48px rgba(20, 36, 31, 0.06);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .ny-path-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 0 var(--line), 0 20px 56px rgba(20, 36, 31, 0.1);
  }
  :global(.ny-path-img) { border-radius: calc(var(--radius-sm) - 4px); margin-bottom: 4px; }
  .ny-path-card.is-featured { border-color: var(--gold); background: #fff; }
  .ny-path-card.is-featured::before {
    content: 'HIGHEST TICKET';
    position: absolute; top: -11px; left: 24px;
    background: var(--gold); color: var(--ink);
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    padding: 5px 10px; border-radius: var(--radius-pill);
  }
  .ny-path-tag {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold-deep); margin: 0;
  }
  .ny-path-card h3 { font-size: 1.4rem; margin: 0; }
  .ny-path-card p:not(.ny-path-tag) { color: var(--text-muted); font-size: 15px; margin: 0; }
  .ny-path-cta { margin-top: 8px; font-weight: 600; color: var(--forest); font-size: 14px; }

  .ny-trends { background: var(--bone-deep); padding: clamp(48px, 6vw, 80px) 0; }
  .ny-trend-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .ny-trend-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 24px;
  }
  .ny-trend-card h3 { font-size: 1rem; margin: 0 0 8px; color: var(--forest); }
  .ny-trend-card p { font-size: 13.5px; color: var(--text-muted); margin: 0; line-height: 1.6; }

  .ny-track-record { background: var(--forest); padding: 32px 0; text-align: center; }
  .ny-track-record-line {
    margin: 0;
    color: var(--bone);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .ny-lifestyle-grid { grid-template-columns: 1fr; }
    .ny-trend-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 780px) {
    .ny-path-grid { grid-template-columns: 1fr; }
    .ny-trend-grid { grid-template-columns: 1fr; }
  }
</style>
