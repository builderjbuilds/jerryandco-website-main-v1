---
// Shared 4-step process section for the NY division — reuses the global
// .section-steps/.steps-row/.step classes already proven on
// landlord-property-management.astro and backyard-additions-design-build.astro,
// so no new CSS is introduced. Copy is parameterized per funnel since the
// "reveal" step means something different for a $6K fence vs. a $25K addition.
interface Step {
  title: string;
  body: string;
}
interface Props {
  eyebrow?: string;
  headline?: string;
  steps?: Step[];
}

const defaultSteps: Step[] = [
  { title: 'Site walkthrough & written quote', body: 'A real look at the property — not a phone-number guess — and a same-day written quote, tiered so you know exactly what you’re choosing between.' },
  { title: 'Permit coordination & material selection', body: 'Anything that requires a permit gets filed before work starts, not discovered after. You pick materials off a real sample, not a stock photo.' },
  { title: 'Insured install, protected property', body: 'Your lawn, driveway, and neighbors’ sightlines are treated like they matter. Daily cleanup — no job site sitting half-finished over a weekend.' },
  { title: 'Final walkthrough & warranty handoff', body: 'We walk the finished work with you before we call it done, and you get the guarantee terms in writing — not a verbal "call me if anything comes up."' },
];

const {
  eyebrow = 'How it works',
  headline = 'From first call to finished project — four steps, no surprises.',
  steps = defaultSteps,
} = Astro.props;

// e.g. 4 steps -> "1fr auto 1fr auto 1fr auto 1fr"
const gridCols = Array.from({ length: steps.length }, () => '1fr').join(' auto ');
---

<section class="ny-section-steps">
  <div class="wrap">
    <div class="section-head" data-reveal="up">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{headline}</h2>
    </div>
    <div class="ny-steps-row" style={`--ny-steps-cols: ${gridCols};`} data-reveal="up" data-delay="1">
      {steps.map((step, i) => (
        <>
          <div class="ny-step">
            <div class="ny-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
          {i < steps.length - 1 && <div class="ny-step-connector" aria-hidden="true"></div>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .ny-section-steps { background: var(--bone); padding: clamp(48px, 6vw, 80px) 0; }
  .ny-steps-row {
    display: grid;
    grid-template-columns: var(--ny-steps-cols);
    gap: 0;
    align-items: start;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .ny-step {
    background: var(--bone-deep);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ny-step-num {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    color: rgba(200, 160, 85, 0.3);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .ny-step h3 { color: var(--forest); font-size: 1.05rem; margin: 0; }
  .ny-step p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.68; margin: 0; }

  .ny-step-connector {
    width: 32px;
    height: 2px;
    background: var(--line);
    margin-top: clamp(44px, 5vw, 60px);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .ny-steps-row { grid-template-columns: 1fr; }
    .ny-step-connector { width: 2px; height: 28px; margin: 0 auto; }
  }
</style>
