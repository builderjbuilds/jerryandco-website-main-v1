---
// NY Division header — deliberately NOT the shared src/components/Header.astro.
//
// Header.astro's nav is entirely MA cabinet-refinishing: Services dropdown
// (#cabinet-feature, #services), Why Refinish dropdown, /projects/, /gallery/,
// /about/, and an Areas dropdown of MA cabinet-refinishing town pages
// (/cabinet-refinishing-medford/ etc.). None of that is relevant to an
// outdoor-living visitor in Westchester, and every one of those links would
// walk an NY prospect straight into the MA cabinet portfolio — the opposite
// of what this division needs. This header is scoped entirely to /ny/*,
// same visual language (ink/bone/gold, sticky header, same mobile-nav
// mechanics), zero links outside the NY division.

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = '/ny/', ctaLabel = 'Get My Quote' } = Astro.props;
---

<header>
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/ny/" aria-label="Jerry & Co. Outdoor Living — home">
      <img class="logo-img" src="/img/brand/logo-navbar.png" alt="Jerry & Co. Home Improvement — Outdoor Living Division" height="44" width="auto" />
    </a>

    <!-- Desktop nav -->
    <ul class="nav-links" role="list">
      <li><a href="/ny/" class="nav-link">Home</a></li>
      <li><a href="/ny/fencing-sheds-patios/" class="nav-link">Fencing &amp; Outdoor Living</a></li>
      <li><a href="/ny/landlord-property-management/" class="nav-link">Landlords &amp; Property Managers</a></li>
      <li><a href="/ny/backyard-additions-design-build/" class="nav-link">Design-Build</a></li>
    </ul>

    <div class="nav-cta">
      <a class="nav-phone" href="tel:+13476026801">
        <span class="live-dot" aria-hidden="true"></span>(347) 602-6801
      </a>
      <a class="btn btn-gold" href={ctaHref}>{ctaLabel}</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="hamburger" id="navOpen" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile overlay -->
  <div class="nav-scrim" id="navScrim" aria-hidden="true"></div>
  <div class="mobile-nav" id="mobileNav" role="dialog" aria-modal="true" aria-label="Navigation" aria-hidden="true">
    <button class="mobile-close" id="navClose" aria-label="Close navigation menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <ul role="list">
      <li><a href="/ny/">Home</a></li>
      <li><a href="/ny/fencing-sheds-patios/">Fencing &amp; Outdoor Living</a></li>
      <li><a href="/ny/landlord-property-management/">Landlords &amp; Property Managers</a></li>
      <li><a href="/ny/backyard-additions-design-build/">Design-Build</a></li>
    </ul>
    <a class="mobile-phone-cta" href="tel:+13476026801">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      (347) 602-6801
    </a>
    <a class="btn btn-gold btn-block mobile-cta" href={ctaHref}>{ctaLabel}</a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid var(--line-dark);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--gutter);
    max-width: 1440px;
    margin: 0 auto;
    color: var(--bone);
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--bone);
    flex-shrink: 0;
  }
  .logo-img { height: 44px; width: auto; display: block; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    text-decoration: none;
    color: var(--bone);
    opacity: 0.8;
    transition: opacity 0.15s;
    padding: 8px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .nav-link:hover { opacity: 1; }

  .nav-cta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  :global(.nav-cta .btn) {
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 0 18px;
  }
  .nav-phone {
    font-size: 17px;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.01em;
    opacity: 1;
    transition: color 0.15s;
    white-space: nowrap;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .nav-phone:hover { color: var(--bone); }

  .live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    position: relative;
  }
  .live-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: #22c55e;
    opacity: 0.35;
    animation: livepulse 1.8s ease-out infinite;
  }
  @keyframes livepulse {
    0%   { transform: scale(1);   opacity: 0.35; }
    70%  { transform: scale(2.2); opacity: 0; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  .nav-phone::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--bone);
    transition: width 0.2s ease;
  }
  .nav-phone:hover::after { width: 100%; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: 4px;
    color: var(--bone);
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile close button */
  .mobile-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    background: none;
    border: none;
    color: var(--bone);
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.15s;
  }
  .mobile-close:hover { opacity: 1; }
  .mobile-close svg { width: 22px; height: 22px; }

  /* Scrim behind sliding nav */
  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(5, 14, 10, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s ease, visibility 0.32s;
    z-index: 48;
    pointer-events: none;
  }
  header.nav-open .nav-scrim {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Mobile nav overlay — slide from right */
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100vw;
    background: var(--ink);
    z-index: 49;
    padding: 80px 24px 120px;
    overflow-y: auto;
    overflow-x: hidden;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.32s;
  }
  .mobile-nav.is-open {
    transform: translateX(0);
    visibility: visible;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mobile-nav li { border-bottom: 1px solid var(--line-dark); }
  .mobile-nav li:last-child { border-bottom: none; }
  .mobile-nav a {
    display: block;
    padding: 14px 0;
    color: rgba(247, 243, 234, 0.85);
    text-decoration: none;
    font-size: 16px;
    transition: color 0.15s;
  }
  .mobile-nav a:hover { color: var(--bone); }
  .mobile-phone-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    padding: 16px 24px;
    border: 2px solid var(--gold);
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background 0.15s, color 0.15s;
  }
  .mobile-phone-cta svg { width: 18px; height: 18px; flex-shrink: 0; }
  .mobile-phone-cta:hover { background: var(--gold); color: var(--ink); }
  .mobile-nav .mobile-phone-cta,
  .mobile-nav .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .mobile-nav .mobile-cta { margin-top: 12px; }

  /* Hamburger → X morph on open — driven by aria-expanded, no JS class needed */
  #navOpen[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #navOpen[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #navOpen[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 880px) {
    .nav-links, .nav-cta { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const openBtn  = document.getElementById('navOpen')  as HTMLButtonElement | null;
  const closeBtn = document.getElementById('navClose') as HTMLButtonElement | null;
  const panel    = document.getElementById('mobileNav') as HTMLElement | null;
  const scrim    = document.getElementById('navScrim')  as HTMLElement | null;
  const hdr      = openBtn?.closest('header') as HTMLElement | null;

  const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';

  function openNav() {
    if (!panel || !openBtn) return;
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    hdr?.classList.add('nav-open');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeNav() {
    if (!panel || !openBtn) return;
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    hdr?.classList.remove('nav-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn?.addEventListener('click', openNav);
  closeBtn?.addEventListener('click', closeNav);
  scrim?.addEventListener('click', closeNav);

  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNav));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('is-open')) closeNav();
  });

  panel?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !panel) return;
    const focusable = [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
      (el) => el.offsetParent !== null
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last?.focus(); }
    } else {
      if (document.activeElement === last)  { e.preventDefault(); first?.focus(); }
    }
  });
</script>
