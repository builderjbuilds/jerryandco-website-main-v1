  </div>
</footer>

<style>
  .nj-footer { background: var(--ink); color: #B9C4BE; padding: 50px 0 26px; }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; margin-bottom: 36px; }
  .foot-brand .word { font-family: var(--font-serif); font-size: 19px; color: var(--bone); margin-bottom: 10px; }
  .foot-brand p { font-size: 12.5px; line-height: 1.7; color: #96A39C; max-width: 280px; margin: 0; }
  .nj-footer h4 { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
  .nj-footer ul { list-style: none; padding: 0; margin: 0; }
  .nj-footer li { margin-bottom: 9px; font-size: 12.5px; }
  .nj-footer a { text-decoration: none; color: #B9C4BE; }
  .nj-footer a:hover { color: var(--gold); }
  .foot-legal {
    border-top: 1px solid var(--line-dark);
    padding-top: 22px; font-size: 11.5px; color: #8B978F; line-height: 1.7; text-align: center;
  }
  @media (max-width: 860px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
