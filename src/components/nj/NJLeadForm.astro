---
// NJ Design-Build — lead intake form (ported from mockup 2's #intake-form).
// Posts to src/pages/api/nj-lead-relay.ts, which forwards to a GHL Workflow's
// Inbound Webhook trigger (GHL Webhook Integration build spec, Aug 31 2026) —
// NOT the NY funnels' /api/ghl-lead-relay direct-API route. GHL's own
// workflow builder owns the contact upsert, tagging, Plans-Ready branch, and
// opportunity creation on that side; this form just posts the flat payload
// nj-lead-relay.ts expects.
//
// No hydration directive needed — this is a plain Astro component with an
// inline <script> (same pattern as NYLeadForm.astro), which Astro always
// ships and runs client-side regardless of client:* directives.
//
// Two-page handoff (build spec Section 4.2's stated default): on success we
// stash the lead record in sessionStorage — NOT localStorage, since that's
// the one thing this build spec explicitly moves away from — and send the
// visitor to /nj/book-site-visit/ to pick a time on the real GHL calendar.
---

<div class="form-card nj-lead-card" id="nj-intake-form-card">
  <h2>Lock In Your Site Visit</h2>
  <p class="fee-note">Bring your plans if you've got them — no plans yet, we'll help you get there. <strong>Visit fee depends on your project</strong> and is confirmed based on your answers below before you book a time. Either way, you leave with a fixed price and a start date, not a ballpark.</p>

  <form class="nj-lead-form" id="nj-intake-form" novalidate>
    <input type="text" name="_gotcha" class="nj-bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="field">
      <label for="nj-fullName">Full Name <span class="req">*</span></label>
      <input id="nj-fullName" name="fullName" type="text" placeholder="Your full name" required autocomplete="name" />
    </div>

    <div class="form-row">
      <div class="field">
        <label for="nj-email">Email <span class="req">*</span></label>
        <input id="nj-email" name="email" type="email" placeholder="Your email address" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="nj-phone">Phone <span class="req">*</span></label>
        <input id="nj-phone" name="phone" type="tel" placeholder="Mobile number" required autocomplete="tel" />
      </div>
    </div>

    <div class="field">
      <label for="nj-street">Street Address <span class="req">*</span></label>
      <input id="nj-street" name="street" type="text" placeholder="Enter your full address" required autocomplete="street-address" />
    </div>

    <div class="form-row">
      <div class="field">
        <label for="nj-city">City <span class="req">*</span></label>
        <input id="nj-city" name="city" type="text" placeholder="e.g. Lyndhurst" required autocomplete="address-level2" />
      </div>
      <div class="field">
        <label for="nj-state">State <span class="req">*</span></label>
        <input id="nj-state" name="state" type="text" placeholder="e.g. NJ" required autocomplete="address-level1" value="NJ" />
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="nj-postal">Postal Code <span class="req">*</span></label>
        <input id="nj-postal" name="postal" type="text" placeholder="ZIP code" required autocomplete="postal-code" />
      </div>
      <div class="field">
        <label for="nj-county">County</label>
        <input id="nj-county" name="county" type="text" placeholder="e.g. Bergen" />
      </div>
    </div>

    <div class="field">
      <label for="nj-projectType">Project Type <span class="req">*</span></label>
      <select id="nj-projectType" name="projectType" required>
        <option value="">Select one…</option>
        <option value="deck_addition_enclosure">Deck / Addition / Patio Enclosure (Design-Build)</option>
        <option value="fencing">Fencing</option>
        <option value="hardscaping">Hardscaping / Patio</option>
        <option value="decking">Decking (no addition)</option>
        <option value="other">Other outdoor project</option>
      </select>
    </div>

    <div class="field">
      <label for="nj-plansStatus">Do you already have plans or blueprints prepared? <span class="req">*</span></label>
      <select id="nj-plansStatus" name="plansStatus" required>
        <option value="">Select one…</option>
        <option value="plans_and_zoning_ready">Yes — plans and zoning approval ready</option>
        <option value="plans_only">Yes — plans ready, zoning not yet approved</option>
        <option value="no_plans_yet">No — need design help too</option>
      </select>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="nj-timeline">Timeline <span class="req">*</span></label>
        <select id="nj-timeline" name="timeline" required>
          <option value="">Select one…</option>
          <option value="asap">ASAP</option>
          <option value="1_3_months">1–3 months</option>
          <option value="3_6_months">3–6 months</option>
          <option value="researching">Just researching</option>
        </select>
      </div>
      <div class="field">
        <label for="nj-budget">Rough Budget Range</label>
        <select id="nj-budget" name="budget">
          <option value="">Select one…</option>
          <option value="under_25k">Under $25K</option>
          <option value="25_50k">$25K–$50K</option>
          <option value="50_90k">$50K–$90K</option>
          <option value="90k_plus">$90K+</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="nj-message">Tell Us About Your Project</label>
      <textarea id="nj-message" name="message" placeholder="e.g. Converting our existing patio into a sunroom — elevated platform, exterior stairs, electric, roofing. Zoning approved, blueprints ready."></textarea>
    </div>

    <div class="consent">
      <input type="checkbox" id="nj-consentUpdates" name="consentUpdates" required />
      <label for="nj-consentUpdates">By checking this box, I consent to receive non-marketing text messages from <b>Jerry &amp; Co. Home Improvement LLC</b> about project request related information and updates.</label>
    </div>
    <div class="consent">
      <input type="checkbox" id="nj-consentMarketing" name="consentMarketing" />
      <label for="nj-consentMarketing">By checking this box, I consent to receive marketing and promotional messages including special offers, discounts, and updates from <b>Jerry &amp; Co. Home Improvement LLC</b> at the phone number provided. Frequency may vary.</label>
    </div>

    <p class="required-note">* Required</p>
    <button type="submit" class="btn btn-gold btn-block" data-ph-event="nj_lead_submit" data-ph-label="funnel_d_nj_design_build">
      <span class="btn-label">Start My Site Visit Request</span>
      <span class="spinner" hidden></span>
    </button>
    <p class="nj-form-status" role="status" aria-live="polite"></p>
    <p class="fine-print">We'll bring proof of registration and insurance to the walk-through — see it before you commit to anything.</p>
  </form>

  <div class="form-success">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
    <h3>Got It — Now Pick Your Site Visit Time</h3>
    <p>Your project details are on their way to our team. You don't have to wait for us to call — grab a time on the calendar right now, and Jerry will already have your details before he shows up.</p>
    <div class="nj-confirm-recap" id="nj-confirm-recap"></div>
    <a href="/nj/book-site-visit/" class="btn btn-gold" id="nj-book-visit-link">Choose Your Site Visit Time →</a>
    <p class="fine-print" style="margin-top:16px;">Prefer to skip the wait? Email <a href="mailto:support@jerryandcohome.com">support@jerryandcohome.com</a> and mention this page.</p>
  </div>

  <div class="form-error" id="nj-form-error">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <h3>Couldn't Submit Online</h3>
    <p>No problem — nothing's lost. Send us your details below and we'll follow up directly, or try again if it was a one-off glitch.</p>
    <a href="#" class="btn btn-gold btn-block" id="nj-error-mailto" target="_blank" rel="noopener">Email Us Your Details</a>
    <button type="button" class="btn btn-outline-dark btn-block" id="nj-error-retry">Try Again</button>
  </div>
</div>

<style>
  .nj-lead-card { position: relative; background: #fff; border-radius: 14px; padding: 34px 32px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.28); }
  .nj-lead-card h2 { font-size: 22px; color: var(--forest); text-align: center; margin-bottom: 6px; }
  .fee-note { text-align: center; font-size: 13px; color: var(--text-muted); margin-bottom: 22px; line-height: 1.5; }
  .fee-note strong { color: var(--gold-deep); }
  .req { color: var(--gold-deep); }
  .nj-bot-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .required-note { font-size: 10px; color: var(--text-muted); text-align: right; margin: 4px 0 0; }
  .fine-print { margin-top: 12px; text-align: center; font-size: 11.5px; color: var(--text-muted); line-height: 1.5; }
  .fine-print a { color: var(--gold-deep); }
  .consent { display: flex; gap: 8px; align-items: flex-start; margin: 12px 0; font-size: 11px; color: var(--text-muted); line-height: 1.5; }
  .consent input { width: auto; margin-top: 2px; }
  .consent label { font-size: 11px; font-weight: 400; margin: 0; }
  .nj-form-status { font-size: 14px; margin: 12px 0 0; min-height: 1.3em; text-align: center; }
  .nj-form-status[data-state='error'] { color: #a3402f; }
  .form-success { display: none; text-align: center; }
  .form-success.show { display: block; }
  .nj-confirm-recap { margin: 20px 0; text-align: left; background: var(--bone); border-radius: 8px; padding: 14px 16px; font-size: 13px; color: var(--text); }
  .nj-confirm-recap div { padding: 3px 0; }
  .nj-confirm-recap b { color: var(--forest); }

  .form-error { display: none; text-align: center; }
  .form-error.show { display: block; }
  .form-error svg { color: #a3402f; width: 40px; height: 40px; margin-bottom: 12px; }
  .form-error h3 { font-size: 20px; color: var(--forest); margin-bottom: 8px; }
  .form-error p { font-size: 13.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 20px; }
  .form-error #nj-error-retry { margin-top: 10px; }
</style>

<script>
  const card = document.getElementById('nj-intake-form-card');
  const form = document.getElementById('nj-intake-form') as HTMLFormElement | null;
  const statusEl = card?.querySelector<HTMLElement>('.nj-form-status');
  const successEl = card?.querySelector<HTMLElement>('.form-success');
  const recapEl = document.getElementById('nj-confirm-recap');
  const bookLink = document.getElementById('nj-book-visit-link') as HTMLAnchorElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const spinnerEl = submitBtn?.querySelector<HTMLElement>('.spinner');
  const errorEl = card?.querySelector<HTMLElement>('.form-error');
  const errorMailtoLink = document.getElementById('nj-error-mailto') as HTMLAnchorElement | null;
  const errorRetryBtn = document.getElementById('nj-error-retry') as HTMLButtonElement | null;

  // Shake + highlight any field that fails HTML5 validation (required,
  // type="email", etc.) — the form carries `novalidate` so the browser
  // never silently blocks/relies on its own bubble UI alone; this keeps
  // that same constraint-validation data but makes the rejection visible
  // and prevents an all-blank submission from ever reaching the relay.
  function markInvalidFields(f: HTMLFormElement) {
    const invalids = Array.from(f.querySelectorAll(':invalid')) as HTMLElement[];
    invalids.forEach((el) => {
      const wrap = el.closest<HTMLElement>('.field, .consent') || el;
      wrap.classList.remove('field-invalid');
      void wrap.offsetWidth; // reflow so a repeated failure replays the shake
      wrap.classList.add('field-invalid');
    });
    return invalids;
  }

  form?.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    if (!el.validity) return;
    const wrap = el.closest<HTMLElement>('.field, .consent');
    if (wrap && el.validity.valid) wrap.classList.remove('field-invalid');
  });

  errorRetryBtn?.addEventListener('click', () => {
    errorEl?.classList.remove('show');
    if (form) form.style.display = '';
  });

  function setLoading(isLoading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = isLoading;
    if (isLoading) {
      submitBtn.setAttribute('data-loading', '');
    } else {
      submitBtn.removeAttribute('data-loading');
    }
    if (spinnerEl) spinnerEl.hidden = !isLoading;
  }

  function escapeHtml(v: string) {
    return v.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
  }

  // Maps this form's snake_case select values to the exact label strings the
  // "NJ Plans Ready" GHL custom field's options use (per the GHL webhook
  // integration spec, Section 2 step 4) — nj-lead-relay.ts branches on
  // whether this string starts with "Yes".
  const PLANS_STATUS_LABELS: Record<string, string> = {
    plans_and_zoning_ready: 'Yes – zoning approved',
    plans_only: 'Yes – zoning pending',
    no_plans_yet: 'No – need design too',
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (statusEl) { statusEl.removeAttribute('data-state'); statusEl.textContent = ''; }
    errorEl?.classList.remove('show');

    if (!form.checkValidity()) {
      form.reportValidity();
      markInvalidFields(form);
      if (statusEl) {
        statusEl.dataset.state = 'error';
        statusEl.textContent = 'Please fill in the highlighted fields above.';
      }
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

    if (data._gotcha) return; // honeypot — never even hit the relay

    setLoading(true);

    // GHL Webhook Integration build spec (Aug 31, 2026) — relays through
    // src/pages/api/nj-lead-relay.ts to a GHL Workflow's Inbound Webhook
    // trigger, replacing the earlier direct-API /api/ghl-lead-relay call
    // for this form. That route's LeadPayload shape is flatter than this
    // form's fields, so map into it here rather than changing the relay
    // (which is spec-locked to match the GHL workflow's field mapping).
    const relayPayload = {
      name: data.fullName,
      phone: data.phone,
      email: data.email,
      address: [data.street, data.city, data.state, data.postal].filter(Boolean).join(', '),
      projectType: data.projectType,
      plansStatus: PLANS_STATUS_LABELS[data.plansStatus] || data.plansStatus,
      timeline: data.timeline,
      budget: data.budget,
      notes: data.message,
      formSource: 'intake',
      website: data._gotcha, // honeypot field name the relay checks
    };

    try {
      const res = await fetch('/api/nj-lead-relay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(relayPayload),
      });
      const result = await res.json();
      if (!res.ok || !result.ok) {
        throw new Error(result.error || 'Something went wrong. Please email us directly.');
      }

      // Session-scoped handoff to the scheduler page — not localStorage.
      try {
        sessionStorage.setItem('jerryco_nj_last_lead', JSON.stringify({
          fullName: data.fullName,
          phone: data.phone,
          email: data.email,
          street: data.street,
          city: data.city,
          state: data.state,
          projectType: data.projectType,
        }));
      } catch { /* sessionStorage unavailable — scheduler just won't prefill */ }

      form.style.display = 'none';
      successEl?.classList.add('show');
      if (recapEl) {
        recapEl.innerHTML =
          `<div><b>Name:</b> ${escapeHtml(data.fullName || '')}</div>` +
          `<div><b>Address:</b> ${escapeHtml([data.street, data.city, data.state, data.postal].filter(Boolean).join(', '))}</div>` +
          `<div><b>Project:</b> ${escapeHtml(data.projectType || '')}</div>` +
          `<div><b>Timeline:</b> ${escapeHtml(data.timeline || '')}</div>`;
      }

      if (typeof (window as any).posthog !== 'undefined') {
        (window as any).posthog.capture('nj_lead_converted', { funnel: 'D' });
      }
    } catch (err: any) {
      // Relay failed — show a dedicated error panel instead of firing
      // window.open() here: by the time this async catch runs, the click
      // that triggered submit is long gone, so browsers treat that open()
      // call as an un-requested popup and either block it outright or hand
      // back an empty about:blank tab with no prefilled fields. A real
      // anchor the visitor clicks themselves doesn't have that problem —
      // it's a live user gesture, so the mail client actually opens with
      // their details already in the body (build spec Section 7.1 step 5 /
      // Section 8's "nothing silently lost" requirement, just via a link
      // instead of an auto-fired popup).
      const bodyLines = [
        'New site-visit request — NJ/NY-Metro Design-Build funnel (relay failed, sent via fallback)',
        '',
        `Name: ${data.fullName || ''}`,
        `Email: ${data.email || ''}`,
        `Phone: ${data.phone || ''}`,
        `Address: ${[data.street, data.city, data.state, data.postal].filter(Boolean).join(', ')}`,
        `County: ${data.county || '(not given)'}`,
        `Project type: ${data.projectType || ''}`,
        `Plans status: ${data.plansStatus || ''}`,
        `Timeline: ${data.timeline || ''}`,
        `Budget range: ${data.budget || '(not given)'}`,
        `Message: ${data.message || '(none)'}`,
      ].join('\n');
      if (errorMailtoLink) {
        errorMailtoLink.href = `mailto:support@jerryandcohome.com?subject=${encodeURIComponent('New Site Visit Request — ' + (data.fullName || 'New request'))}&body=${encodeURIComponent(bodyLines)}`;
      }
      form.style.display = 'none';
      errorEl?.classList.add('show');
      setLoading(false);
    }
  });
</script>
