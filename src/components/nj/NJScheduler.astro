---
// NJ Design-Build — scheduler right panel. Ported from mockup 3's
// #booking-form, with ONE deliberate departure the build spec requires
// (Section 4.3): the mockup's 4-fixed-time-slot buttons were a placeholder
// that would double-book against Jerry's real calendar, so this ships a real
// calendar booking link instead.
//
// 2026-09-14 — switched from the GHL calendar iframe embed to a direct link
// to a Google Calendar Appointment Schedule (GHL's server was down, and
// GHL's booking widget has no fallback of its own — see nj-lead-relay.ts's
// header comment for the same outage). Tested iframe-embedding the Google
// page first: the short link (calendar.app.google/...) sets
// X-Frame-Options: SAMEORIGIN on the redirect hop, and the direct
// calendar.google.com/calendar/appointments/schedules/... URL is tied to an
// authenticated session and renders blank for visitors — neither embeds
// reliably, and Google doesn't officially support iframe embedding of
// Appointment Schedules for personal (non-Workspace) accounts. A plain
// outbound link is the robust option, and it also means Google's own
// booking form (name/email/phone/custom questions) replaces the
// hand-rolled fields this component used to render above the iframe —
// no more duplicate, unsynced "Your Details" inputs.
//
// Prefill comes from sessionStorage (set by NJLeadForm on submit) — never
// localStorage, and never the mockup's own multi-submission array. It's
// display-only here (there's no API to hand it to Google's booking form),
// so it just confirms to the visitor we already have their project details.
interface Props {
  bookingUrl: string;
}
const { bookingUrl } = Astro.props;
---

<div class="nj-sched-inner">
  <div id="nj-booking-form">
    <h2>Choose Your Site Visit</h2>
    <p class="lede">Pick a day and a time that works — the visit runs about 45–60 minutes. Fee is confirmed based on your project (plans-ready visits are lighter than from-scratch design visits) and shown in your confirmation.</p>

    <div class="recap-strip" id="nj-recap-strip"></div>

    <div class="field-block">
      <label>Pick Your Time</label>
      <p class="booking-note">You'll pick your time and enter your contact details on the next screen — it opens in a new tab so this page stays put.</p>
      <a class="btn btn-gold btn-block" id="nj-booking-link" href={bookingUrl} target="_blank" rel="noopener">Choose Your Site Visit Time →</a>
    </div>

    <div class="fine-note">No obligation beyond the visit itself. We'll email a reminder before your visit. Need to talk first? Email <a href="mailto:support@jerryandcohome.com">support@jerryandcohome.com</a>.</div>
  </div>
</div>

<style>
  .nj-sched-inner { max-width: 560px; width: 100%; }
  .nj-sched-inner h2 { font-size: 24px; color: var(--forest); margin-bottom: 6px; }
  .nj-sched-inner .lede { font-size: 13.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 28px; }

  .recap-strip { display: none; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 24px; font-size: 12.5px; color: var(--text); }
  .recap-strip.show { display: block; }
  .recap-strip b { color: var(--forest); }

  .field-block { margin-bottom: 26px; }
  .field-block > label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--forest); margin-bottom: 10px; }
  .booking-note { font-size: 12.5px; line-height: 1.55; color: var(--text-muted); margin: 0 0 14px; }

  .btn-block { display: block; width: 100%; text-align: center; }

  .fine-note { margin-top: 12px; text-align: center; font-size: 11px; color: var(--text-muted); }
  .fine-note a { color: var(--gold-deep); }
</style>

<script>
  interface StoredLead {
    fullName?: string; phone?: string; email?: string;
    street?: string; city?: string; state?: string; projectType?: string;
  }

  function escapeHtml(v: string) {
    return v.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
  }

  // Same option→label map as NJLeadForm.astro's projectType <select> — the
  // stored lead only has the raw snake_case value, so translate it back to
  // human copy for the recap strip instead of showing e.g. "deck_addition_enclosure".
  const PROJECT_TYPE_LABELS: Record<string, string> = {
    deck_addition_enclosure: 'Deck / Addition / Patio Enclosure',
    fencing: 'Fencing',
    hardscaping: 'Hardscaping / Patio',
    decking: 'Decking',
    other: 'your outdoor project',
  };

  const recapStrip = document.getElementById('nj-recap-strip');

  try {
    const raw = sessionStorage.getItem('jerryco_nj_last_lead');
    if (raw) {
      const lead: StoredLead = JSON.parse(raw);
      const projectLabel = (lead.projectType && PROJECT_TYPE_LABELS[lead.projectType]) || 'your project';
      if (recapStrip) {
        recapStrip.innerHTML = `Picking up from your project request: <b>${escapeHtml(projectLabel)}</b>${lead.city ? ' in <b>' + escapeHtml(lead.city) + '</b>' : ''}. We already have your name and contact info — just confirm them again on the booking screen.`;
        recapStrip.classList.add('show');
      }
      sessionStorage.removeItem('jerryco_nj_last_lead');
    }
  } catch { /* sessionStorage unavailable — scheduler still works, just unprefilled */ }
</script>
